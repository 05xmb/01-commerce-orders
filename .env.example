# 本地开发环境变量（.env 不入库，复制本文件填写）
# MySQL DSN（库名：电商订单表1）
MYSQL_DSN=root:请填写密码@tcp(127.0.0.1:3306)/电商订单表1?charset=utf8mb4&parseTime=true&loc=Local
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=

# 预置账号初始口令（种子仅落散列；本地 .env 填写，部署由运行环境注入，仓库不存明文）
SEED_PASSWORD=请填写演示口令

# 交易系统与模拟渠道共享的 HMAC 密钥（请填写随机值，仓库不存明文）
CHANNEL_SECRET=请填写随机值

# 交易系统请求渠道退款时的渠道地址
CHANNEL_BASE_URL=http://127.0.0.1:8902
# 渠道回调交易系统的地址
TRADE_NOTIFY_URL=http://127.0.0.1:8888
